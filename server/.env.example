# ===== 应用 =====
APP_ENV=dev                        # dev / test / prod
DEBUG=true
APP_NAME=juzi-phone

# ===== 数据库（库名 juzi_phone，对齐数据库设计文档；账号 orange 由 M0 创建） =====
DATABASE_URL=mysql+pymysql://orange:orange@localhost:3306/juzi_phone?charset=utf8mb4
# 测试环境可切：sqlite:///./test.db（模型兼容层）

# ===== 认证 =====
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== CORS =====
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ===== 上传 =====
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=5
ALLOWED_IMAGE_TYPES=jpg,png,webp

# ===== 其他 =====
SITE_BASE_URL=http://localhost:5173   # sitemap 生成用
STATS_RETENTION_DAYS=180
LOG_RETENTION_DAYS=90
